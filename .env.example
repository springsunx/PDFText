PDFTEXT_PORT=8000
PDFTEXT_IMAGE=ghcr.io/springsunx/pdftext:latest
PDFTEXT_MAX_FILE_SIZE_MB=50
PDFTEXT_MAX_OUTPUT_SIZE_MB=100
PDFTEXT_TIMEOUT_SECONDS=120
PDFTEXT_MCP_MAX_FILE_SIZE_MB=2

# 公网或反向代理部署 MCP 时，把实际 Host 与 Origin 加入下面的逗号分隔列表。
PDFTEXT_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*,pdftotext,pdftotext:*
PDFTEXT_MCP_ALLOWED_ORIGINS=http://localhost,http://localhost:*,http://127.0.0.1,http://127.0.0.1:*
